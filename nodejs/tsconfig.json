{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "authorization/index.ts",
        "authorization/role.ts",
        "authorization/roleAssignment.ts",
        "compute/index.ts",
        "compute/instance.ts",
        "config/index.ts",
        "config/vars.ts",
        "index.ts",
        "kubernetes/index.ts",
        "kubernetes/kubernetesCluster.ts",
        "kubernetes/kubernetesNodePool.ts",
        "loadbalancer/index.ts",
        "loadbalancer/networkLoadBalancer.ts",
        "natgateway/index.ts",
        "natgateway/internetNatGatewayInstance.ts",
        "network/getSkus.ts",
        "network/index.ts",
        "network/internetGateway.ts",
        "network/network.ts",
        "network/nic.ts",
        "network/publicIp.ts",
        "network/routeTable.ts",
        "network/securityGroup.ts",
        "network/securityGroupRule.ts",
        "network/subnet.ts",
        "objectstorage/index.ts",
        "objectstorage/objectStorageAccount.ts",
        "provider.ts",
        "region/getRegions.ts",
        "region/index.ts",
        "storage/blockStorage.ts",
        "storage/getSkus.ts",
        "storage/image.ts",
        "storage/index.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts",
        "workspace/index.ts",
        "workspace/workspace.ts"
    ]
}
